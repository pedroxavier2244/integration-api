# APP
APP_NAME="Integration API"
APP_VERSION="1.0.0"
ENVIRONMENT=development
DEBUG=false

# JWT — gere com: openssl rand -hex 32
JWT_SECRET_KEY=troque_por_uma_chave_segura_gerada_com_openssl

# DATABASE (PostgreSQL local na VPS — mesmo banco do ETL)
DATABASE_URL=postgresql+asyncpg://postgres:senha@localhost:5432/nome_do_banco
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# REDIS
REDIS_URL=redis://localhost:6379/0

# EMAIL (SMTP Outlook corporativo)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=noreply@suaempresa.com.br
SMTP_PASSWORD=senha_da_conta_outlook
SMTP_FROM=noreply@suaempresa.com.br
SMTP_TLS=true

# FRONTEND (usado nos links dos emails)
FRONTEND_URL=http://localhost:3000
